# Claude Code local state - session data, worktrees, task locks, scheduled runs.
# Whole directory excluded; nothing under .claude/ should ever be pushed.
.claude/

# Curated per-OS catalog CSVs go here when you're ready to commit them.
# Leaving an explicit allow rule makes intent clear if future ignores get added.
!NSRL/extras/*.csv

# Generated by Build-BehavioralFingerprintTable.psm1 (menu 1i) — multi-MB derived data; regenerate locally
output-baseline/behavioral-fingerprints/

# Two fidelity artifacts that exceed GitHub's 100 MB per-file hard limit and cannot be pushed.
# Regenerate locally via Build-VTFidelityIndex; consumer (ElasticAlertAgent.psm1) fails soft
# on their absence — Import-FidelityIndices marks the file dim as loaded-but-empty and skips
# the legacy flat fallback with a Write-Warning.
#   - fidelity-file.json   (~153 MB): per-dim index for the 'file' artifact dimension.
#   - fidelity-index.json  (~307 MB): deprecated flat compat shim, replaced by 18 per-dim
#                                     indices under the v2 schema. Kept for -UseLegacyFidelity
#                                     A/B calibration lane only; not required for normal use.
output-baseline/fidelity-file.json
output-baseline/fidelity-index.json
