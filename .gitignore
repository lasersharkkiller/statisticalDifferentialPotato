# Claude Code local state - session data, worktrees, task locks, scheduled runs.
# Whole directory excluded; nothing under .claude/ should ever be pushed.
.claude/

# Curated per-OS catalog CSVs go here when you're ready to commit them.
# Leaving an explicit allow rule makes intent clear if future ignores get added.
!NSRL/extras/*.csv

# Generated by Build-BehavioralFingerprintTable.psm1 (menu 1i) — multi-MB derived data; regenerate locally
output-baseline/behavioral-fingerprints/

# Two fidelity artifacts that exceed GitHub's 100 MB per-file hard limit and cannot be pushed.
# Regenerate locally via Build-VTFidelityIndex; consumer (ElasticAlertAgent.psm1) fails soft
# on their absence — Import-FidelityIndices marks the file dim as loaded-but-empty and skips
# the legacy flat fallback with a Write-Warning.
#   - fidelity-file.json   (~153 MB): per-dim index for the 'file' artifact dimension.
#   - fidelity-index.json  (~307 MB): deprecated flat compat shim, replaced by 18 per-dim
#                                     indices under the v2 schema. Kept for -UseLegacyFidelity
#                                     A/B calibration lane only; not required for normal use.
output-baseline/fidelity-file.json
output-baseline/fidelity-index.json

# Weekly-progress caches: large, machine-local, rebuildable.
# The ledger (VTSubmissionLedger.csv) and the series (weekly-progress.csv) ARE tracked.
output/metrics/_behaviour-cache.csv
output/metrics/_universe-cache.json
output/metrics/_snapshot_pending_*.csv
output/metrics/VTSubmissionLedger_unattributed.csv
output/metrics/_universe-hashes.txt
output/ca/_ip-cache.csv

# Regenerable per-vendor unified differential maps (every indicator x file hit; 75-430 MB each).
# Stripped from history 2026-11-03 (4 exceeded GitHub's 100 MB hard limit). The useful
# per-category Targeted*DifferentialAnalysis.json stay tracked; regenerate maps via
# tools/Invoke-VendorDifferential.ps1.
output/vendor-differential/**/Targeted_Analysis_Map.csv

# Per-dim fidelity index that now exceeds GitHub's 100 MB limit (109 MB on disk);
# regenerate via Build-VTFidelityIndex (mirrors fidelity-file.json / fidelity-index.json above).
output-baseline/fidelity-registry.json

# Regenerable APT/malware-family unified differential maps (same class as the
# vendor-differential maps above; apt/ copies bloated the push to ~1GB uncompressed).
# Stripped from history 2026-11-03. Per-category Targeted*DifferentialAnalysis.json stay tracked.
apt/**/Targeted_Analysis_Map.csv
