                                                                  "{\"unknown section\": {\"name\": \"NONPAGE\", \"raw_address\": \"0x0000a000\", \"virtual_address\": \"0x0000a000\", \"virtual_size\": \"0x000000b0\", \"size_of_data\": \"0x00001000\", \"characteristics\": \"IMAGE_SCN_CNT_INIT",
                                                                  "{\"unknown section\": {\"name\": \"PAGE\", \"raw_address\": \"0x0000b000\", \"virtual_address\": \"0x0000b000\", \"virtual_size\": \"0x0000a244\", \"size_of_data\": \"0x0000b000\", \"characteristics\": \"IMAGE_SCN_CNT_CODE|IM",
                                                                  "{\"unknown section\": {\"name\": \"INIT\", \"raw_address\": \"0x00016000\", \"virtual_address\": \"0x00016000\", \"virtual_size\": \"0x000004c7\", \"size_of_data\": \"0x00001000\", \"characteristics\": \"IMAGE_SCN_CNT_CODE|IM",
                                                                  "{\"unknown section\": {\"name\": \"GFIDS\", \"raw_address\": \"0x00017000\", \"virtual_address\": \"0x00017000\", \"virtual_size\": \"0x000000ac\", \"size_of_data\": \"0x00001000\", \"characteristics\": \"IMAGE_SCN_CNT_INITIA"
                                                              ],
